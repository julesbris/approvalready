 {
  "name": "nested",
  "condition": {
   "all": [
    {
     "any": [
      {
       "fact": "t",
       "op": "equals",
       "value": "sec"
      },
      {
       "fact": "t",
       "op": "equals",
       "value": "new"
      }
     ]
    },
    {
     "not": {
      "fact": "lots",
      "op": "greater_than",
      "value": 2
     }
    }
   ]
  },
  "facts": {
   "t": "new",
   "lots": 2
  },
  "expected": "TRUE"
 },
 {
