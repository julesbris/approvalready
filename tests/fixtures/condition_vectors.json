[
 {
  "name": "equals string match",
  "condition": {
   "fact": "a",
   "op": "equals",
   "value": "x"
  },
  "facts": {
   "a": "x"
  },
  "expected": "TRUE"
 },
 {
  "name": "equals string mismatch",
  "condition": {
   "fact": "a",
   "op": "equals",
   "value": "x"
  },
  "facts": {
   "a": "y"
  },
  "expected": "FALSE"
 },
 {
  "name": "equals is case sensitive",
  "condition": {
   "fact": "a",
   "op": "equals",
   "value": "x"
  },
  "facts": {
   "a": "X"
  },
  "expected": "FALSE"
 },
 {
  "name": "equals int and float",
  "condition": {
   "fact": "n",
   "op": "equals",
   "value": 1
  },
  "facts": {
   "n": 1.0
  },
  "expected": "TRUE"
 },
 {
  "name": "equals number vs numeric string",
  "condition": {
   "fact": "n",
   "op": "equals",
   "value": 600
  },
  "facts": {
   "n": "600"
  },
  "expected": "FALSE"
 },
 {
  "name": "equals bool",
  "condition": {
   "fact": "b",
   "op": "equals",
   "value": true
  },
  "facts": {
   "b": true
  },
  "expected": "TRUE"
 },
 {
  "name": "bool is not a number",
  "condition": {
   "fact": "b",
   "op": "equals",
   "value": 1
  },
  "facts": {
   "b": true
  },
  "expected": "FALSE"
 },
 {
  "name": "number is not a bool",
  "condition": {
   "fact": "n",
   "op": "equals",
   "value": true
  },
  "facts": {
   "n": 1
  },
  "expected": "FALSE"
 },
 {
  "name": "equals missing fact is unknown",
  "condition": {
   "fact": "a",
   "op": "equals",
   "value": "x"
  },
  "facts": {},
  "expected": "UNKNOWN"
 },
 {
  "name": "equals null fact is unknown",
  "condition": {
   "fact": "a",
   "op": "equals",
   "value": "x"
  },
  "facts": {
   "a": null
  },
  "expected": "UNKNOWN"
 },
 {
  "name": "equals empty string is missing",
  "condition": {
   "fact": "a",
   "op": "equals",
   "value": "x"
  },
  "facts": {
   "a": ""
  },
  "expected": "UNKNOWN"
 },
 {
  "name": "equals list fact single value",
  "condition": {
   "fact": "m",
   "op": "equals",
   "value": "x"
  },
  "facts": {
   "m": [
    "x"
   ]
  },
  "expected": "TRUE"
 },
 {
  "name": "equals dates",
  "condition": {
   "fact": "d",
   "op": "equals",
   "value": "2026-01-31"
  },
  "facts": {
   "d": "2026-01-31"
  },
  "expected": "TRUE"
 },
 {
  "name": "not_equals",
