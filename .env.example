# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# --- Domains (production) ---
PRIMARY_DOMAIN=approvalready.com.au
ACME_EMAIL=ops@example.com
CORS_ORIGINS=https://approvalready.com.au,https://app.approvalready.com.au,https://partners.approvalready.com.au,https://review.approvalready.com.au
ALLOWED_HOSTS=api.approvalready.com.au,api,localhost

# --- Application ---
LOG_LEVEL=INFO
SECRET_KEY=replace-with-48-plus-random-characters
APP_VERSION=0.1.0
GIT_SHA=unknown
WEB_CONCURRENCY=2

# --- PostgreSQL (internal network only) ---
# Owner role: used only by the migrate service (migrations, role provisioning, reference data).
POSTGRES_USER=approvalready
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=approvalready
# Application role: what api/worker/scheduler connect as. Not an owner, no BYPASSRLS, so
# row-level security applies. Created (and its password kept in sync) by migrate.
APP_DB_USER=approvalready_app
APP_DB_PASSWORD=replace-with-another-strong-password

# --- Redis (internal network only) ---
REDIS_PASSWORD=replace-with-strong-password

# --- Images ---
IMAGE_PREFIX=approvalready
IMAGE_TAG=latest

# --- Email (transactional: verification, password reset, invitations) ---
# Any SMTP relay (e.g. Amazon SES Sydney, Postmark, SendGrid). Development uses Mailpit.
EMAIL_FROM=ApprovalReady <no-reply@approvalready.com.au>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Reserved for later milestones (not read yet) ---
# STORAGE_BACKEND=local            # local | s3
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# AI_PROVIDER=mock
