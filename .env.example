# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# --- Domains (production) ---
PRIMARY_DOMAIN=approvalready.com.au
ACME_EMAIL=ops@example.com
CORS_ORIGINS=https://approvalready.com.au,https://app.approvalready.com.au,https://partners.approvalready.com.au,https://review.approvalready.com.au
ALLOWED_HOSTS=api.approvalready.com.au,api,localhost

# --- Application ---
LOG_LEVEL=INFO
SECRET_KEY=replace-with-48-plus-random-characters
APP_VERSION=0.1.0
GIT_SHA=unknown
WEB_CONCURRENCY=2

# --- PostgreSQL (internal network only) ---
# Owner role: used only by the migrate service (migrations, role provisioning, reference data).
POSTGRES_USER=approvalready
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=approvalready
# Application role: what api/worker/scheduler connect as. Not an owner, no BYPASSRLS, so
# row-level security applies. Created (and its password kept in sync) by migrate.
APP_DB_USER=approvalready_app
APP_DB_PASSWORD=replace-with-another-strong-password

# --- Redis (internal network only) ---
REDIS_PASSWORD=replace-with-strong-password

# --- Images ---
IMAGE_PREFIX=approvalready
IMAGE_TAG=latest

# --- Email (transactional: verification, password reset, invitations) ---
# Any SMTP relay (e.g. Amazon SES Sydney, Postmark, SendGrid). Development uses Mailpit.
EMAIL_FROM=ApprovalReady <no-reply@approvalready.com.au>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Address, parcel and vessel lookups (free government sources, no keys) ---
# Production defaults to "qld_spatial": the questionnaire offers the council area, lot and
# plan, land area and state-mapped overlays for Queensland addresses. "none" turns that off;
# "mock" returns made-up data for development and is refused in production.
# PROPERTY_FACTS_PROVIDER=qld_spatial
# LOOKUPS_ENABLED=false turns off the address search, parcel and UVI lookups as well.
# LOOKUPS_ENABLED=true
# AMSA renames its vessel list file each update; we find it on AMSA's page. Only set this
# if that stops working, to the .xlsx file's address.
# AMSA_VESSEL_LIST_URL=

# --- Documents (uploads and generated reports) ---
# Nothing to set to start: files go to the "uploads" Docker volume and are virus-checked by
# the clamav service. To use S3-compatible object storage instead (AWS Sydney, Wasabi,
# Backblaze B2), set these. The bucket must be private.
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=ap-southeast-2
# STORAGE_S3_ENDPOINT_URL=          # only for non-AWS providers
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# UPLOAD_MAX_MB=20                  # Caddy allows 25 MB request bodies

# --- AI drafting (plain-language explanations, grant application notes) ---
# Off by default. AI only rewords findings and drafts from a project's own answers; drafts
# that mention anything not in their input are rejected. To switch it on, create a key at
# console.anthropic.com and set both lines. "mock" writes canned text for development and is
# refused in production.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5          # cheaper: claude-sonnet-5-5 (then set the prices below)
# AI_EFFORT=medium                  # low | medium | high
# AI_INPUT_PRICE_PER_MTOK_USD=4     # for the cost column at /admin/ai
# AI_OUTPUT_PRICE_PER_MTOK_USD=20
# AI_JOBS_PER_USER_PER_HOUR=20

# --- Payments (Stripe) ---
# Off by default: nothing is for sale. To switch on, set all three (see DEPLOY_KAMATERA.md
# "Payments"): the secret key from Stripe's API keys page, and the signing secret of a
# webhook endpoint pointing at https://api.<PRIMARY_DOMAIN>/v1/billing/stripe/webhook.
# Then set prices at /admin/billing. Test keys (sk_test_...) move no real money.
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
