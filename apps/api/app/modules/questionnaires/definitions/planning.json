{
  "key": "planning.general",
  "vertical": "PLANNING",
  "title": "Planning and building: tell us about your project",
  "description": "Your answers describe the site and what you want to build. They are facts for the assessment, not an assessment themselves.",
  "sections": [
    {
      "title": "The site",
      "questions": [
        {"key": "property.address", "type": "ADDRESS", "label": "Site address", "required": true},
        {
          "key": "property.lga", "type": "SELECT", "label": "Which council area is the site in?",
          "help_text": "We fill this in when you pick a Queensland address above. It is also on your rates notice. Leave this blank if you are not sure.",
