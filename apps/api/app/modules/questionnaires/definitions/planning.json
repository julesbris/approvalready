            {"value": "kowanyama", "label": "Kowanyama Aboriginal Shire Council"},
            {"value": "livingstone", "label": "Livingstone Shire Council"},
            {"value": "lockhart_river", "label": "Lockhart River Aboriginal Shire Council"},
            {"value": "lockyer_valley", "label": "Lockyer Valley Regional Council"},
            {"value": "logan", "label": "Logan City Council"},
            {"value": "longreach", "label": "Longreach Regional Council"},
            {"value": "mackay", "label": "Mackay Regional Council"},
            {"value": "mapoon", "label": "Mapoon Aboriginal Shire Council"},
            {"value": "maranoa", "label": "Maranoa Regional Council"},
            {"value": "mareeba", "label": "Mareeba Shire Council"},
            {"value": "mckinlay", "label": "McKinlay Shire Council"},
            {"value": "mornington", "label": "Mornington Shire Council"},
            {"value": "mount_isa", "label": "Mount Isa City Council"},
            {"value": "murweh", "label": "Murweh Shire Council"},
            {"value": "napranum", "label": "Napranum Aboriginal Shire Council"},
            {"value": "noosa", "label": "Noosa Shire Council"},
            {"value": "north_burnett", "label": "North Burnett Regional Council"},
            {"value": "northern_peninsula_area", "label": "Northern Peninsula Area Regional Council"},
            {"value": "palm_island", "label": "Palm Island Aboriginal Shire Council"},
            {"value": "paroo", "label": "Paroo Shire Council"},
            {"value": "pormpuraaw", "label": "Pormpuraaw Aboriginal Shire Council"},
            {"value": "quilpie", "label": "Quilpie Shire Council"},
            {"value": "redland", "label": "Redland City Council"},
            {"value": "richmond", "label": "Richmond Shire Council"},
            {"value": "rockhampton", "label": "Rockhampton Regional Council"},
            {"value": "scenic_rim", "label": "Scenic Rim Regional Council"},
            {"value": "somerset", "label": "Somerset Regional Council"},
            {"value": "south_burnett", "label": "South Burnett Regional Council"},
            {"value": "southern_downs", "label": "Southern Downs Regional Council"},
